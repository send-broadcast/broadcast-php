{
  "name": "broadcast/broadcast-php",
  "description": "PHP client for the Broadcast email platform. Subscribers, sequences, broadcasts, segments, templates, autopilot, webhooks, and transactional email.",
  "type": "library",
  "keywords": ["broadcast", "email", "newsletter", "transactional", "email-marketing", "sendbroadcast"],
  "homepage": "https://sendbroadcast.net",
  "license": "MIT",
  "authors": [
    { "name": "Simon Chiu" }
  ],
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*",
    "psr/log": "^1.1 || ^2.0 || ^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.0"
  },
  "suggest": {
    "psr/http-client": "Use any PSR-18 client instead of the bundled cURL transport"
  },
  "autoload": {
    "psr-4": {
      "Broadcast\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Broadcast\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true
  }
}
